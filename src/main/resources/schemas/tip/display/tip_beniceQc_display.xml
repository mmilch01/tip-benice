	</DisplayField>
	<DisplayField id="TIP_BENICEQC_PROJECT_IDENTIFIER" header="TIP_BENICEQC ID" visible="true" searchable="false" data-type="string" xsi:type="SubQueryField">
		<Content type="sql">tip_beniceqc_project_id</Content>
		<HTML-Link>
			<SecureLink elementName="tip:beniceQc">
				<securityMappingValue displayFieldId="PROJECTS" schemaElementMap="tip:beniceQc/sharing/share/project"/>
				<securityMappingValue displayFieldId="PROJECT" schemaElementMap="tip:beniceQc/project"/>
			</SecureLink>
			<Property name="HREF" value="@WEBAPPapp/action/DisplayItemAction/search_value/@Field1/search_element/tip:beniceQc/search_field/tip:beniceQc.ID/project/@Field2">
				<InsertValue id="Field1" field="EXPT_ID"/>
				<InsertValue id="Field2" field="@WHERE"/>
			</Property>
		</HTML-Link>
		<SubQuery>SELECT DISTINCT COALESCE(label,sharing_share_xnat_experimentda_id) AS tip_beniceqc_project_id,sharing_share_xnat_experimentda_id FROM (	SELECT sharing_share_xnat_experimentda_id,label FROM xnat_experimentdata_share WHERE project='@WHERE'	UNION 	SELECT id,label FROM xnat_experimentData WHERE project='@WHERE' )SEARCH</SubQuery>
		<MappingColumns>
			<MappingColumn schemaField="tip:beniceQc.ID" queryField="sharing_share_xnat_experimentda_id"/>
		</MappingColumns>
	</DisplayField>
