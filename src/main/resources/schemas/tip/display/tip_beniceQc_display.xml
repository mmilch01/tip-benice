	<DisplayField header="Label" id="LABEL" data-type="string">
	<DisplayFieldElement name="Field1" schema-element="tip:beniceQc.ID"/>
	<DisplayFieldElement name="Field2" schema-element="tip:beniceQc.label"/>
	<Content type="sql">COALESCE(@Field2, @Field1)</Content>
		<HTML-Link>
			<SecureLink elementName="tip:beniceQc">
				<securityMappingValue displayFieldId="PROJECTS" schemaElementMap="tip:beniceQc/sharing/share/project"/>
				<securityMappingValue displayFieldId="PROJECT" schemaElementMap="tip:beniceQc/project"/>
			</SecureLink>
			<Property name="HREF" value="@WEBAPPapp/action/DisplayItemAction/search_value/@Field1/search_element/tip:beniceQc/search_field/tip:beniceQc.ID">
				<InsertValue id="Field1" field="EXPT_ID"/>
			</Property>
			<Property name="ONCLICK" value="return rpt('@Field1','tip:beniceQc','tip:beniceQc.ID');">
				<InsertValue id="Field1" field="EXPT_ID"/>
			</Property>
			<Property name="TITLE" value="Inserted: @Field1 (@Field2)">
				<InsertValue id="Field1" field="INSERT_DATE"/>
				<InsertValue id="Field2" field="INSERT_USER"/>
			</Property>
		</HTML-Link>
	</DisplayField>
	<DisplayField id="PROJECT" header="Project" visible="true" searchable="true" data-type="string">
