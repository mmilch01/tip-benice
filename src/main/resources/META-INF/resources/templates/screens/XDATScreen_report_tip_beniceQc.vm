<script>
	jq(document).ready(function(){
		// initialize qc image sliders
        createQcSlider(jq('.movementograms'));
        createQcSlider(jq('#fcmri-qc-images'));
        createQcSlider(jq('#registration-qc-images'));
        createQcSlider(jq('#rsn-qc-images'));

		// initialize subjectID values
        XNAT.xhr.getJSON({
			url: XNAT.url.rootUrl('/REST/experiments/$sessionId?format=json'),
			success: function(data){
                var subjectId = data.items[0].data_fields.subject_ID;
                jq.data(jq('#acceptQc'),'subjectid',subjectId);
                jq.data(jq('#rejectQc'),'subjectid',subjectId);

                jq('#acceptQc').removeClass('hidden');
                jq('#rejectQc').removeClass('hidden');
            }
        });

		// initialize tabs
        function summaryIndexChanged(){
            var activeIndex=this.get("activeIndex");
            YAHOO.util.Cookie.set("${project.getId()}.summary.index",activeIndex);
        }
        function toggleLI(_name){
            var elements = document.getElementsByName("li_"+_name);
            for(var trI=0;trI<elements.length;trI++){
                if(elements[trI].style.display=="none"){
                    elements[trI].style.display="block";
                }else{
                    elements[trI].style.display="none";
                }
            }
        }
        function summaryTabManagerInit(){
            window.summaryTabView = new YAHOO.widget.TabView('exptSummary');

            window.expt_summary_module = new YAHOO.widget.Module("expt_summary_module",{visible:false,zIndex:5});

			## #addCustomScreenJS($om.getXSIType() "report/tabs_js")

            window.expt_summary_module.show();

            var tabIndex=YAHOO.util.Cookie.get("${om.getId()}.summary.index");
            window.summaryTabView.set('activeIndex',tabIndex||0);

            window.summaryTabView.subscribe("activeTabChange",summaryIndexChanged);
        }
        summaryTabManagerInit();

        // navigate user to appropriate section of report when selecting "Jump To..." selector
        jq('.reportSectionNavigator').on('change',function(){
            var selectedId = jq(this).find('option:selected').val();
            var elementPosition = jq('#'+selectedId).prop('offsetTop');
            console.log(selectedId, elementPosition);
            jq(window).scrollTop(elementPosition);
        });
    });
</script>
