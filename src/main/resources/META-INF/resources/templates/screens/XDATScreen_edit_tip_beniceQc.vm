<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 3.2//EN">
$page.setTitle("Validate RSN Assessor")
$page.setLinkColor($ui.alink)
$page.setVlinkColor($ui.vlink)
#xdatMonthRange()
#xdatDayRange()
#xdatYearRange()
#set($qcValues = [["Failed","Failed"],["Passed","Passed"]])
#set ($sessionId = $!item.getStringProperty("tip:beniceQc/imageSession_ID"))

#if ($data.message)
<div class="alert">$data.message</div>
#end
<p>
<form ID="form1" name="form1" method="post" action="$link.setAction("ModifyItem")">
    <input type="hidden" name="project" value="$!{project}" >
	#if($vr)
        <div class="alert">Invalid parameters:<BR>$vr.toHTML()</div>
	#end

    <h2>RSN Gen Assessor Validation Status</h2>

    <div>
        #parse("/screens/xnat_edit_experimentData.vm")
    </div>
    <hr style="margin: 2em 0" />
    <div>
        #parse("/screens/EditProjectSpecificFields.vm")
    </div>

    <!-- BEGIN fs:fsData/validation -->
    <h3>TIP RSN Gen Validation</h3>

    <table class="xnat-table">
        <TR><th align="left">Status</th><TD>
            <select name="tip:beniceQc/validation/status">
                <option selected disabled>Select a Status</option>
                <option value="Passed">Passed</option>
                <option value="Failed">Failed</option>
            </select>
        </TD></TR>
        <TR><th>Date</th><td>
            <span id="qc-datepicker" class="single us today" data-value="" data-validate="onblur" data-input-id="fs:fsData/validation/date" data-input-name="fs:fsData/validation/date"></span>
            <script type="text/javascript">
                jq(document).ready(function(){
                    jq('#qc-datepicker').data('value',XNAT.data.todaysDate.us);
                    XNAT.app.datePicker.init(jQuery('#qc-datepicker'));
                });
            </script>
        </td></TR>
        <TR><th align="left">Method</th><TD><textarea rows="5" cols="20" id="tip:beniceQc/validation/method" name="tip:beniceQc/validation/method">$!item.getStringProperty("tip:beniceQc/validation/method")</textarea></TD></TR>
        <TR><th align="left">Notes</th><TD>#xdatStringBox("tip:beniceQc/validation/notes" $item "" $vr)</TD></TR>
        <TR><th align="left">Validated_by</th><TD>#xdatStringBox("tip:beniceQc/validation/validated_by" $item $!data.getSession().getAttribute("user").getUsername() $vr)</TD></TR>
        #xdatHiddenBox("tip:beniceQc/validation/xnat_validationData_id" $item "")
        #xdatHiddenBox("tip:beniceQc/imageAssessorData/imageSession_ID" $item "" $vr)
        #xdatHiddenBox("tip:beniceQc/fcmri_preprocessing/display_protocol/table/column" $item "" $vr)
        #xdatHiddenBox("tip:beniceQc/fcmri_preprocessing/display_protocol/info" $item "" $vr)
    </table>
    <!-- END fs:fsData/validation -->

    <div name="xdatEditProps">#xdatEditProps($item $edit_screen)</div>

    <p><input type="button" ONCLICK="validateForm();"  name="eventSubmit_doInsert" value="Submit" class="btn btn1"/></p>
</form>

<script type="text/javascript">
    function validateForm()
    {
        //INSERT CUSTOM CONTENT HERE
        document.getElementById("form1").submit();
        //validateExperimentForm();
        //return false;
    }
</script>

